		<button left="0" top="420" width="200" height="30" text="Rolar pendentes (mestre)" onClick="self:doRollPending()"/>
		<button left="244" top="420" width="100" height="30" text="Fechar" onClick="self:closeMe()"/>
	</layout>
	</scrollBox>
</popupForm>
