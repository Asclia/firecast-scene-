<?xml version="1.0" encoding="UTF-8"?>
<popupForm name="frmFSTBRequest" width="360" height="470" drawContainer="true" resizable="true"
           placement="center" cancelable="true">

	<script><![CDATA[
		local options = {};
		local MAX = 16;

		function self:closeMe()
			if options.close ~= nil then options.close(); else self:close(); end;
		end;

		-- info = {onSend(req), onRollPending(), results() -> {title, rows}, close}
		function self:prepareFor(info)
			options = info or {};
			self:typeChanged();
			self:refresh();
		end;

		function self:typeChanged()
			self.edtCustom.enabled = self.cmbType.value == "custom";
		end;

		function self:doSend()
			local label = self.cmbType.text or "";
			local key = self.cmbType.value or "custom";

			if key == "custom" then
				label = self.edtCustom.text or "";
				key = "c_" .. label:lower();

				if label:gsub("%s", "") == "" then
					showMessage("Digite o nome da rolagem.");
					return;
				end;
			end;

			if options.onSend ~= nil then
				options.onSend({label = label, key = key, dc = tonumber(self.edtDC.text), secret = self.cbxSecret.checked,
				                target = self.cmbTarget.value or "sel"});
			end;

			self:refresh();
		end;

		function self:doRollPending()
			if options.onRollPending ~= nil then options.onRollPending(); end;
			self:refresh();
		end;

		function self:refresh()
			if options.results == nil then return; end;
			local r = options.results();
			self:beginUpdate();
			self.labResTitle.text = r.title or "Nenhum pedido ainda.";

			for i = 1, MAX do
				local row = r.rows[i];
				self["res" .. i].visible = row ~= nil;

				if row ~= nil then
					self["resName" .. i].text = row.name;
					self["resTotal" .. i].text = row.total or "...";
					self["resStatus" .. i].text = row.status or "";
					self["resStatus" .. i].fontColor = row.color or "#FFFFFF";
				end;
			end;

			self:endUpdate();
		end;
	]]></script>

	<scrollBox align="client">
	<layout left="8" top="6" width="344" height="456">
		<label left="0" top="0" width="344" height="24" fontSize="15" fontStyle="bold" text="Pedir rolagem"/>

		<label left="0" top="30" width="80" height="26" text="Rolagem:" vertTextAlign="center"/>
		<comboBox name="cmbType" left="84" top="30" width="260" height="26" onChange="self:typeChanged()"
		          items="{'Iniciativa', 'Fortitude', 'Reflexos', 'Vontade', 'Percepção', 'Furtividade', 'Sentir Motivação', 'Conhecimento', 'Acrobacia', 'Escalar', 'Outra...'}"
		          values="{'init', 'fort', 'ref', 'will', 'perc', 'stealth', 'sense', 'know', 'acro', 'climb', 'custom'}" value="perc"/>
		<edit name="edtCustom" left="84" top="60" width="260" height="26" textPrompt="nome da rolagem (Outra...)"/>

		<label left="0" top="92" width="80" height="26" text="CD:" vertTextAlign="center"/>
		<edit name="edtDC" left="84" top="92" width="60" height="26" type="number" textPrompt="-"/>
		<checkBox name="cbxSecret" left="156" top="92" width="188" height="26" text="Secreta (só o mestre vê)"/>

		<label left="0" top="124" width="80" height="26" text="Quem:" vertTextAlign="center"/>
		<comboBox name="cmbTarget" left="84" top="124" width="260" height="26"
		          items="{'Tokens selecionados', 'Todos os tokens de jogadores'}" values="{'sel', 'players'}" value="players"/>

		<button left="164" top="158" width="180" height="30" text="Pedir rolagem" fontStyle="bold" onClick="self:doSend()"/>

		<horzLine left="0" top="198" width="344" strokeColor="#FFFFFF30"/>
		<label name="labResTitle" left="0" top="204" width="344" height="22" fontSize="13" fontStyle="bold" fontColor="#FFCC66"
		       wordWrap="false" textTrimming="character"/>
		<layout left="0" top="230" width="344" height="184">
		<layout name="res1" align="top" height="24" visible="false">
			<label name="resStatus1" align="right" width="90" horzTextAlign="trailing" vertTextAlign="center" fontSize="12" fontStyle="bold"/>
			<label name="resTotal1" align="right" width="70" horzTextAlign="center" vertTextAlign="center" fontSize="13" fontStyle="bold"/>
			<label name="resName1" align="client" vertTextAlign="center" fontSize="12" wordWrap="false" textTrimming="character"/>
		</layout>
