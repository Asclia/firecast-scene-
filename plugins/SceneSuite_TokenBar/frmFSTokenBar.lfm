<?xml version="1.0" encoding="UTF-8"?>
<popupForm name="frmFSTokenBar" width="680" height="128" drawContainer="true" resizable="true"
           placement="bottom" cancelable="false">

	<script><![CDATA[
		local options = {};
		local MAX = 16;
		local tileUid = {};

		-- info = {model() -> {tiles = {...}, last = "texto", isGM}, onTile(uid), onRequest(), onClose()}
		function self:prepareFor(info)
			options = info or {};
			self:refresh();
		end;

		function self:refresh()
			if options.model == nil then return; end;
			local m = options.model();
			self:beginUpdate();
			tileUid = {};

			for i = 1, MAX do
				local t = m.tiles[i];
				local tile = self["tile" .. i];

				if t == nil then
					tile.visible = false;
				else
					tile.visible = true;
					tileUid[i] = t.uid;
					self["tileImg" .. i].src = t.image or "";
					self["tileName" .. i].text = t.name or "?";
					self["tileHP" .. i].text = t.hp or "";
					self["tileInfo" .. i].text = t.info or "";
					self["tileBg" .. i].strokeColor = t.selected and "#FFD54F" or "#FFFFFF30";
					self["tileBg" .. i].strokeSize = t.selected and 2 or 1;
				end;
			end;

			self.labLast.text = m.last or "";
			self.btnRequest.visible = m.isGM == true;
			self.labEmpty.visible = #m.tiles == 0;
			self:endUpdate();
		end;

		function self:tileClick(i)
			if tileUid[i] ~= nil and options.onTile ~= nil then
				options.onTile(tileUid[i]);
			end;
		end;

		function self:doRequest()
			if options.onRequest ~= nil then options.onRequest(); end;
		end;

		function self:doClose()
			if options.onClose ~= nil then options.onClose(); end;
		end;
	]]></script>

	<layout align="top" height="26" margins="{left=4, right=4, top=2}">
		<button align="right" width="26" text="X" onClick="self:doClose()"/>
		<button name="btnRequest" align="right" width="120" text="Pedir rolagem" margins="{right=4}" onClick="self:doRequest()"/>
		<label name="labLast" align="client" fontSize="11" fontColor="#FFCC66" wordWrap="false" textTrimming="character"/>
	</layout>

	<scrollBox align="client">
		<label name="labEmpty" align="top" height="24" fontSize="11" fontColor="#B0BEC5"
		       text="Nenhum token de jogador no tabuleiro (tokens com dono)."/>
		<flowLayout align="top" autoHeight="true" margins="{left=2, right=2}">
		<flowPart name="tile1" width="150" height="56" margins="{left=2, right=2, top=2, bottom=2}" visible="false">
			<rectangle name="tileBg1" align="client" color="#FFFFFF12" xradius="6" yradius="6" strokeColor="#FFFFFF30" strokeSize="1"
			           onClick="self:tileClick(1)"/>
			<image name="tileImg1" left="4" top="4" width="48" height="48" style="proportional" hitTest="false"/>
			<label name="tileName1" left="56" top="4" width="90" height="20" fontSize="12" fontStyle="bold" wordWrap="false" textTrimming="character" hitTest="false"/>
			<label name="tileHP1" left="56" top="24" width="90" height="16" fontSize="11" fontColor="#B9F6CA" wordWrap="false" hitTest="false"/>
			<label name="tileInfo1" left="56" top="39" width="90" height="15" fontSize="10" fontColor="#FFCC66" wordWrap="false" textTrimming="character" hitTest="false"/>
