<?xml version="1.0" encoding="UTF-8"?>
<!-- Popup que o mestre "mostra aos jogadores" -->
<popupForm name="frmFSJournalShow" width="420" height="420" drawContainer="true" resizable="true"
           placement="center" cancelable="true">
	<script><![CDATA[
		function self:showEntry(info)
			self.labTitle.text = info.titulo or "";
			self.imgPic.src = info.imagem or "";
			self.imgPic.visible = (info.imagem or "") ~= "";
			self.labText.text = info.resumo or "";
		end;
	]]></script>

	<label name="labTitle" align="top" height="30" fontSize="17" fontStyle="bold" horzTextAlign="center"
	       margins="{left=8, right=8, top=6}" wordWrap="false" textTrimming="character"/>
	<label name="labText" align="bottom" height="90" fontSize="13" wordWrap="true" horzTextAlign="center"
	       margins="{left=10, right=10, bottom=8}"/>
	<image name="imgPic" align="client" style="proportional" margins="{left=8, right=8, top=4, bottom=4}"/>
</popupForm>
