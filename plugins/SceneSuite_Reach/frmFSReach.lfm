<?xml version="1.0" encoding="UTF-8"?>
<popupForm name="frmFSReach" width="430" height="390" drawContainer="true" resizable="true"
           placement="center" cancelable="true">

	<style>
		label.cap {
			width: 130;
			height: 26;
			horzTextAlign: trailing;
			vertTextAlign: center;
			wordWrap: false;
		}
	</style>

	<script><![CDATA[
		local options = {};
		local loading = false;

		function self:closeMe()
			if options.close ~= nil then
				options.close();
			else
				self:close();
			end;
		end;

		function self:loadRecord(r)
			loading = true;
			r = r or {};
			self.edtNatural.text = r.natural or "5 ft";
			self.cbxWeapon.checked = r.weapon == "1";
			self.cbxAdjacent.checked = r.adjacent == "1";
			self.cbxDiag10.checked = r.diag10 ~= "0";
			self.cmbColor.color = r.color or "#E53935";
			self.cmbDiag.value = r.diag or "pf";
			loading = false;
			self:updateHint();
		end;

		function self:readRecord()
			return {
				natural = self.edtNatural.text or "5 ft",
				weapon = self.cbxWeapon.checked and "1" or "0",
				adjacent = self.cbxAdjacent.checked and "1" or "0",
				diag10 = self.cbxDiag10.checked and "1" or "0",
				color = self.cmbColor.color or "#E53935",
				diag = self.cmbDiag.value or "pf"
			};
		end;

		function self:updateHint()
			if loading then
				return;
			end;

			self.cbxAdjacent.enabled = self.cbxWeapon.checked;

			if options.describe ~= nil then
				self.labHint.text = options.describe(self:readRecord());
			end;
		end;

		function self:prepareFor(info)
			options = info or {};
			self.labTitle.text = options.title or "Alcance";
			self:loadRecord(options.record);
		end;

		function self:doApply()
			if options.onApply ~= nil then
				options.onApply(self:readRecord());
			end;

			self:closeMe();
		end;

		function self:doRemove()
			if options.onRemove ~= nil then
				options.onRemove();
			end;

			self:closeMe();
		end;
	]]></script>

	<scrollBox align="client">
	<layout left="10" top="8" width="410" height="368">
		<label name="labTitle" left="0" top="0" width="410" height="24" fontSize="16" fontStyle="bold" wordWrap="false"/>

		<label class="cap" left="0" top="40" text="Alcance natural:"/>
		<edit name="edtNatural" left="136" top="40" width="100" height="26" text="5 ft" onChange="self:updateHint()"/>
		<label left="242" top="40" width="164" height="26" fontSize="11" fontColor="#B0BEC5"
		       text="ex.: 5 ft, 3 m, 2 q" vertTextAlign="center"/>

		<label left="136" top="68" width="270" height="22" fontSize="10" fontColor="#B0BEC5" wordWrap="true"
		       text="Médio 5 ft · Grande 10/5 · Enorme 15/10 · Imenso 20/15 · Colossal 30/20 (alto/longo)"/>

		<checkBox name="cbxWeapon" left="136" top="96" width="280" height="26"
		          text="Arma de haste (dobra o alcance)" onChange="self:updateHint()"/>
		<checkBox name="cbxAdjacent" left="156" top="122" width="260" height="26" fontSize="11"
		          text="...mas ainda ameaça adjacentes" onChange="self:updateHint()"/>
		<checkBox name="cbxDiag10" left="136" top="150" width="280" height="26"
		          text="Exceção de 10 ft na diagonal" onChange="self:updateHint()"/>

		<label class="cap" left="0" top="182" text="Diagonais:"/>
		<comboBox name="cmbDiag" left="136" top="182" width="270" height="26"
		          items="{'Pathfinder (5-10-5)', 'Mesma regra do tabuleiro'}"
		          values="{'pf', 'board'}" value="pf" onChange="self:updateHint()"/>

		<label class="cap" left="0" top="214" text="Cor:"/>
		<colorComboBox name="cmbColor" left="136" top="214" width="60" height="26" useAlpha="false" color="#E53935"/>

		<label name="labHint" left="0" top="250" width="410" height="54" fontSize="12" fontColor="#FFCC66"
		       wordWrap="true" horzTextAlign="center"/>

		<button left="0" top="316" width="120" height="30" text="Remover" onClick="self:doRemove()"/>
		<button left="176" top="316" width="110" height="30" text="Cancelar" onClick="self:closeMe()"/>
		<button left="296" top="316" width="110" height="30" text="Aplicar" fontStyle="bold" onClick="self:doApply()"/>
	</layout>
	</scrollBox>
</popupForm>
